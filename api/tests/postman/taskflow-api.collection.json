                  "});\r",
                  "pm.test('Response contiene token JWT', () => {\r",
                  " const body = pm.response.json();\r",
                  " pm.expect(body).to.have.property('token');\r",
                  " // Guardar el token en la variable de entorno\r",
                  " pm.environment.set('token', body.token);\r",
                  "});"

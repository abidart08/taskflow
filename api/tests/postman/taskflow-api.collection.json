    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registro de usuario (US-01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => {\r",
                  " pm.response.to.have.status(201);\r",
                  "});\r",
                  "pm.test('Response tiene id y email', () => {\r",
                  " const body = pm.response.json();\r",
                  " pm.expect(body).to.have.property('id');\r",
                  " pm.expect(body.email).to.eql('ana@ejemplo.com');\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n \"name\": \"Ana García\",\r\n \"email\": \"ana@ejemplo.com\",\r\n \"password\": \"Segura123!\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "**US-01 — Registrar usuario**  \nCA verificado: El usuario se registra correctamente y retorna identificador y email  \nTipo de test: Funcional — caso positivo  \nResultado esperado: **201 Created** con `id` generado y `email = \"ana@ejemplo.com\"`"
          },
          "response": []
        },
        {
